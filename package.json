{
  "name": "@sero-ai/plugin-google",
  "version": "0.4.1",
  "description": "Google Workspace app for Sero — Gmail & Calendar with gogcli",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p extension/tsconfig.json && tsc --noEmit -p runtime/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "sero": {
    "app": {
      "id": "google",
      "styleIsolation": "scope",
      "name": "Google",
      "icon": "mail",
      "scope": "global",
      "stateFile": ".sero/apps/google/state.json",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "GoogleApp",
      "runtime": "./runtime/index.ts",
      "devPort": 5186,
      "widgets": [
        {
          "id": "mail-indicator",
          "name": "Mail",
          "component": "MailWidget",
          "description": "Unread count and recent inbox threads",
          "defaultSize": {
            "w": 2,
            "h": 2
          },
          "minSize": {
            "w": 2,
            "h": 2
          },
          "maxSize": {
            "w": 3,
            "h": 3
          }
        },
        {
          "id": "agenda",
          "name": "Agenda",
          "component": "CalendarWidget",
          "description": "Upcoming calendar events at a glance",
          "defaultSize": {
            "w": 2,
            "h": 3
          },
          "minSize": {
            "w": 2,
            "h": 2
          },
          "maxSize": {
            "w": 3,
            "h": 4
          }
        }
      ]
    },
    "plugin": {
      "category": "integrations",
      "tags": [
        "google",
        "gmail",
        "calendar",
        "workspace"
      ],
      "minSeroVersion": "0.1.0",
      "runtimeAbi": 3,
      "requiredHostCapabilities": [
        "appAgent.invokeTool",
        "tool.cli",
        "appRuntime.background"
      ],
      "preBuilt": false,
      "bridgeTools": [
        "google",
        "gmail",
        "gcal"
      ]
    }
  },
  "dependencies": {
    "@sero-ai/extension-runtime": "^0.2.0",
    "typebox": "^1.1.37"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.83.0",
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@module-federation/vite": "1.19.1",
    "@sero-ai/app-runtime": "^0.4.1",
    "@sero-ai/common": "^0.3.1",
    "@sero-ai/plugin-vite": "^0.1.0",
    "@sero-ai/ui": "^0.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.4.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.4",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0"
  }
}
